{
    "folders":
    [
        {
            "path": ".",
            "folder_exclude_patterns":
            [
                "_site",
                ".jekyll-cache",
                ".sass-cache",
                "node_modules"
            ],
            "file_exclude_patterns":
            [
                "*.log",
                "*.lock",
                ".jekyll-metadata"
            ]
        }
    ],
    "build_systems":
    [
        {
            "name": "Jekyll Serve",
            "cmd":
            [
                "bundle",
                "exec",
                "jekyll",
                "serve",
                "--incremental",
                "--watch"
            ],
            "working_dir": "${project_path}",
            "shell": false
        },
        {
            "name": "Jekyll Build",
            "cmd":
            [
                "bundle",
                "exec",
                "jekyll",
                "build"
            ],
            "working_dir": "${project_path}",
            "shell": false
        },
        {
            "name": "Jekyll Doctor",
            "cmd":
            [
                "bundle",
                "exec",
                "jekyll",
                "doctor"
            ],
            "working_dir": "${project_path}",
            "shell": false
        },
        {
            "name": "Ruby Bundler Version",
            "cmd":
            [
                "bundle",
                "-v"
            ],
            "working_dir": "${project_path}",
            "shell": false
        }
    ],
    "syntax_override":
    {
        "\\.html$":
        [
            "Liquid",
            "Syntaxes",
            "HTML (Liquid)"
        ]
    },
    "settings":
    {
        "project_environment":
        {
            "env_file": "./find_ruby_path.zsh"
        },
        "SublimeLinter.linters.eslint.disable": true,
        "tab_size": 2,
        "translate_tabs_to_spaces": true,
        "default_encoding": "UTF-8",
        "ensure_newline_at_eof_on_save": true
    },
}
